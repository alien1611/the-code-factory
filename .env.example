# GitHub Authentication
GITHUB_TOKEN=your_personal_access_token_here

# Database Configuration (PostgreSQL or fallback SQLite)
DATABASE_URL=sqlite:///./evidence_verifier.db
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/evidence_verifier

# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Backend Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Docker Sandbox Configuration
DOCKER_ENABLED=false
DOCKER_TIMEOUT_SECONDS=120
DOCKER_MEMORY_LIMIT=512m
DOCKER_CPU_LIMIT=1.0
DOCKER_SANDBOX_IMAGE=evidence-verifier-sandbox:latest

# Security & Workspace Configuration
WORKSPACE_BASE_DIR=./temp_workspaces
CLEANUP_WORKSPACE_ON_FINISH=true
